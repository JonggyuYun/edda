<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- DevExpress NuGet Feed - 라이선스 키 필요 -->
    <add key="DevExpress" value="https://nuget.devexpress.com/api" />
  </packageSources>
  <packageSourceCredentials>
    <DevExpress>
      <!-- DevExpress 라이선스 키를 여기에 설정하거나 환경변수 사용 -->
      <!-- <add key="Username" value="token" /> -->
      <!-- <add key="ClearTextPassword" value="%DEVEXPRESS_NUGET_KEY%" /> -->
    </DevExpress>
  </packageSourceCredentials>
</configuration>
