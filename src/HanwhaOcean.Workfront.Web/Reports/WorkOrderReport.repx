<XtraReportsLayoutSerializer SerializerVersion="23.2.0.0">
  <Item1 Ref="0" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v23.2" Name="WorkOrderReport" PageWidth="827" PageHeight="1169" Version="23.2" DataMember="" DataSource="">
    <Bands>
